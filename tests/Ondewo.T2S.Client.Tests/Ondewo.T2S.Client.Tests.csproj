<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test project for the committed stubs. It is never packaged and never referenced by the
       library: Ondewo.T2S.Client.csproj removes tests/** from its Compile glob. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>Ondewo.T2S.Client.Tests</AssemblyName>
    <!-- Nested under the GENERATED namespace spelling, which for this product is also how the
         package id is spelled (Ondewo.T2S). -->
    <RootNamespace>Ondewo.T2S.Client.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Drives `make test`'s coverage gate. PrivateAssets=all so it can never leak into a
         package that referenced this project. -->
    <PackageReference Include="coverlet.msbuild" Version="6.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Ondewo.T2S.Client.csproj" />
  </ItemGroup>

</Project>
